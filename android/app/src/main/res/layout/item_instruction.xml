<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@drawable/card_bg"
    android:padding="16dp" android:layout_marginBottom="10dp">

    <TextView android:id="@+id/tvNumber"
        android:layout_width="36dp" android:layout_height="36dp"
        android:gravity="center" android:textColor="#FFFFFF"
        android:textStyle="bold" android:textSize="14sp"
        android:background="@drawable/avatar_bg"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="12dp">
        <TextView android:id="@+id/tvTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text" android:textSize="14sp"
            android:textStyle="bold"/>
        <TextView android:id="@+id/tvText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_dim" android:textSize="12sp"
            android:layout_marginTop="4dp" android:lineSpacingExtra="3dp"/>
    </LinearLayout>
</LinearLayout>

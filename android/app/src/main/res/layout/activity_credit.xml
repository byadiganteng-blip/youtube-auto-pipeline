<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp"
        android:gravity="center_horizontal">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/hero_bg"
            android:padding="32dp" android:gravity="center">

            <TextView android:layout_width="120dp" android:layout_height="120dp"
                android:text="YS" android:textColor="#FFFFFF"
                android:textSize="44sp" android:textStyle="bold" android:gravity="center"
                android:background="@drawable/avatar_bg"
                android:fontFamily="sans-serif-black" android:elevation="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="YsDev" android:textColor="#FFFFFF"
                android:textSize="32sp" android:textStyle="bold"
                android:layout_marginTop="20dp" android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Android Developer" android:textColor="#E0F2FE"
                android:textSize="14sp" android:layout_marginTop="4dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="✦ Creator of Cliper On ✦"
                android:textColor="#FFFFFF" android:textSize="12sp"
                android:layout_marginTop="14dp" android:background="#33FFFFFF"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:paddingTop="6dp" android:paddingBottom="6dp"
                android:letterSpacing="0.05"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Terima kasih sudah menggunakan Cliper On 💚"
            android:textColor="@color/text" android:textSize="15sp"
            android:gravity="center" android:paddingTop="24dp"
            android:lineSpacingExtra="4dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Aplikasi ini dibuat dengan ❤️ untuk memudahkan content creator memproses video secara otomatis."
            android:textColor="@color/text_dim" android:textSize="13sp"
            android:gravity="center" android:paddingTop="12dp"
            android:lineSpacingExtra="4dp"/>

        <!-- SAWERIA DONATE CARD -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/donate_card_bg"
            android:padding="20dp" android:layout_marginTop="24dp"
            android:gravity="center">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="☕" android:textSize="40sp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Dukung Developer" android:textColor="#F59E0B"
                android:textSize="18sp" android:textStyle="bold"
                android:layout_marginTop="10dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Kalau aplikasi ini bermanfaat, kamu bisa traktir kopi untuk terus support pengembangan. Terima kasih! 🙏"
                android:textColor="@color/text_dim" android:textSize="12sp"
                android:gravity="center" android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaweria"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="☕  Traktir di Saweria"
                android:textColor="#1F2937" android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/saweria_bg"
                android:stateListAnimator="@null"
                android:letterSpacing="0.03"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="saweria.co/ysdev"
                android:textColor="#FBBF24" android:textSize="11sp"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- INFO CARDS -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="24dp"
            android:baselineAligned="false">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/card_bg" android:padding="16dp"
                android:layout_marginEnd="6dp" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🚀" android:textSize="26sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Fast" android:textColor="@color/text"
                    android:textSize="14sp" android:textStyle="bold"
                    android:layout_marginTop="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Proses cepat" android:textColor="@color/text_dim"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/card_bg" android:padding="16dp"
                android:layout_marginStart="6dp" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔒" android:textSize="26sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Secure" android:textColor="@color/text"
                    android:textSize="14sp" android:textStyle="bold"
                    android:layout_marginTop="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Aman &amp; privat" android:textColor="@color/text_dim"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp"
            android:baselineAligned="false">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/card_bg" android:padding="16dp"
                android:layout_marginEnd="6dp" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✨" android:textSize="26sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Modern" android:textColor="@color/text"
                    android:textSize="14sp" android:textStyle="bold"
                    android:layout_marginTop="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="UI elegan" android:textColor="@color/text_dim"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/card_bg" android:padding="16dp"
                android:layout_marginStart="6dp" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🎯" android:textSize="26sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Auto" android:textColor="@color/text"
                    android:textSize="14sp" android:textStyle="bold"
                    android:layout_marginTop="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Full otomatis" android:textColor="@color/text_dim"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="© 2026 YsDev — All rights reserved"
            android:textColor="@color/text_dim" android:textSize="11sp"
            android:gravity="center" android:layout_marginTop="32dp"
            android:layout_marginBottom="20dp"/>
    </LinearLayout>
</ScrollView>

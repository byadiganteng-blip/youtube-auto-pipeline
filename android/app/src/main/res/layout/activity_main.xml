<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="16dp" android:clipToPadding="false" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="24dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:background="@drawable/hero_bg"
                android:padding="20dp"
                android:baselineAligned="false">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✂️  Cliper On" android:textColor="#FFFFFF"
                        android:textSize="26sp" android:textStyle="bold"
                        android:fontFamily="sans-serif-black"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Otomatis split, upload &amp; watermark"
                        android:textColor="#E0F2FE" android:textSize="13sp"
                        android:layout_marginTop="4dp"/>

                    <TextView android:id="@+id/tvStatus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Siap digunakan ✓" android:textColor="#FFFFFF"
                        android:textSize="12sp" android:layout_marginTop="12dp"
                        android:background="#33FFFFFF"
                        android:paddingStart="10dp" android:paddingEnd="10dp"
                        android:paddingTop="4dp" android:paddingBottom="4dp"/>
                </LinearLayout>

                <!-- NOTIF BUTTON -->
                <FrameLayout android:id="@+id/btnNotif"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/notif_badge_bg"
                    android:clickable="true" android:focusable="true">

                    <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                        android:text="🔔" android:textSize="22sp"
                        android:gravity="center"/>

                    <View android:id="@+id/notifDot"
                        android:layout_width="12dp" android:layout_height="12dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp" android:layout_marginEnd="4dp"
                        android:background="@drawable/notif_dot"
                        android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Video URL" android:textColor="@color/text_dim"
                android:textSize="12sp" android:layout_marginTop="20dp" android:layout_marginStart="4dp"/>
            <EditText android:id="@+id/etUrl"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:hint="Tempel link video di sini…"
                android:textColorHint="@color/text_dim" android:textColor="@color/text"
                android:textSize="14sp" android:background="@drawable/card_bg"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:inputType="textUri" android:layout_marginTop="6dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Mode Watermark" android:textColor="@color/text_dim"
                android:textSize="12sp" android:layout_marginTop="14dp" android:layout_marginStart="4dp"/>
            <Spinner android:id="@+id/spProcessMode"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/card_bg"
                android:popupBackground="@color/bg_card" android:layout_marginTop="6dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Metode Watermark" android:textColor="@color/text_dim"
                android:textSize="12sp" android:layout_marginTop="14dp" android:layout_marginStart="4dp"/>
            <Spinner android:id="@+id/spMethod"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/card_bg"
                android:popupBackground="@color/bg_card" android:layout_marginTop="6dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Ukuran Video" android:textColor="@color/text_dim"
                android:textSize="12sp" android:layout_marginTop="14dp" android:layout_marginStart="4dp"/>
            <Spinner android:id="@+id/spVideoSize"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/card_bg"
                android:popupBackground="@color/bg_card" android:layout_marginTop="6dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Kualitas Video" android:textColor="@color/text_dim"
                android:textSize="12sp" android:layout_marginTop="14dp" android:layout_marginStart="4dp"/>
            <Spinner android:id="@+id/spQuality"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/card_bg"
                android:popupBackground="@color/bg_card" android:layout_marginTop="6dp"/>

            <!-- ═══ DURATION SLIDER ═══ -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="14dp"
                android:layout_marginStart="4dp" android:layout_marginEnd="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Durasi per Part"
                    android:textColor="@color/text_dim" android:textSize="12sp"/>
                <TextView android:id="@+id/tvDurationValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="60 dtk"
                    android:textColor="@color/accent" android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_bg"
                android:padding="12dp" android:layout_marginTop="6dp">

                <SeekBar android:id="@+id/sbDuration"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="600"
                    android:progress="60"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent_light"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="2dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="10s" android:textColor="@color/text_dim"
                        android:textSize="10sp"/>
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                    <TextView android:id="@+id/tvDurationHint"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Video: --"
                        android:textColor="@color/text_dim" android:textSize="10sp"/>
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="10m" android:textColor="@color/text_dim" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tipe Upload" android:textColor="@color/text_dim"
                android:textSize="12sp" android:layout_marginTop="14dp" android:layout_marginStart="4dp"/>
            <Spinner android:id="@+id/spType"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/card_bg"
                android:popupBackground="@color/bg_card" android:layout_marginTop="6dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnProcess"
                android:layout_width="match_parent" android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:text="🎬  PROSES VIDEO"
                android:textColor="#FFFFFF" android:textSize="16sp"
                android:textStyle="bold" android:background="@drawable/hero_bg"
                android:stateListAnimator="@null" android:letterSpacing="0.05"/>

            <!-- MENU GRID (4 tombol: Instruksi, Hasil, Credit, Donate) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:baselineAligned="false">

                <LinearLayout android:id="@+id/menuInstructions"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center" android:background="@drawable/menu_icon_bg"
                    android:padding="12dp" android:layout_marginEnd="3dp"
                    android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📖" android:textSize="24sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Instruksi" android:textColor="@color/text"
                        android:textSize="11sp" android:layout_marginTop="6dp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/menuResults"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center" android:background="@drawable/menu_icon_bg"
                    android:padding="12dp" android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎞️" android:textSize="24sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Hasil" android:textColor="@color/text"
                        android:textSize="11sp" android:layout_marginTop="6dp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/menuCredit"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center" android:background="@drawable/menu_icon_bg"
                    android:padding="12dp" android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="©️" android:textSize="24sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Credit" android:textColor="@color/text"
                        android:textSize="11sp" android:layout_marginTop="6dp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/menuDonate"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:gravity="center" android:background="@drawable/saweria_bg"
                    android:padding="12dp" android:layout_marginStart="3dp"
                    android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="☕" android:textSize="24sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Dukung" android:textColor="#1F2937"
                        android:textSize="11sp" android:textStyle="bold"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>


            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Cliper On v3.3  •  by YsDev"
                android:textColor="@color/text_dim" android:textSize="11sp"
                android:gravity="center" android:layout_marginTop="20dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- ═══ FLOATING CIRCLE PROGRESS ═══ -->
    <FrameLayout android:id="@+id/loadingOverlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/float_card_bg"
            android:elevation="24dp">

            <!-- Outer ring: rotating spinner -->
            <ProgressBar
                android:id="@+id/spinnerRing"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent"
                android:indeterminateTintMode="src_atop"/>

            <!-- Center percentage overlay -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="-52dp">
                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="5%"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tvProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memproses…"
                android:textColor="@color/text"
                android:textSize="11sp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvProgressDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mohon tunggu"
                android:textColor="@color/text_dim"
                android:textSize="9sp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>

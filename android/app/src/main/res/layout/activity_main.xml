<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/bg_light">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:id="@+id/adminTapArea"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/header_gradient"
            android:padding="30dp" android:gravity="center"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🎬" android:textSize="60sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Universal Video Editor" android:textSize="24sp"
                android:textStyle="bold" android:textColor="#FFFFFF" android:layout_marginTop="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Edit • Upload • Auto Split" android:textSize="13sp"
                android:textColor="#FFEBEE" android:layout_marginTop="4dp" />
        </LinearLayout>

        <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:visibility="gone" android:layout_marginTop="16dp"
            android:indeterminateTint="@color/brand_primary" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="16dp">
            <Button android:id="@+id/btnVideoEditor" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="🎬 Editor" android:backgroundTint="#673AB7" android:textColor="#FFFFFF" />
            <Button android:id="@+id/btnStatistics" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="📊 Stats" android:backgroundTint="#00BCD4" android:textColor="#FFFFFF"
                android:layout_marginStart="8dp" />
            <Button android:id="@+id/btnSettings" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="⚙️" android:backgroundTint="#607D8B" android:textColor="#FFFFFF"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_margin="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">

                <TextView android:id="@+id/tvTokenInfo" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="🔐 Memuat..."
                    android:textSize="12sp" android:padding="12dp" android:background="@drawable/card_bg"
                    android:textStyle="bold" />

                <EditText android:id="@+id/etUrl" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="URL Video"
                    android:inputType="textUri" android:padding="14dp"
                    android:background="@drawable/card_bg" android:layout_marginTop="12dp" />

                <TextView android:text="Process Mode" android:textSize="12sp"
                    android:textStyle="bold" android:layout_marginTop="12dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <Spinner android:id="@+id/spinnerProcessMode" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="@drawable/card_bg" />

                <TextView android:text="Video Size" android:textSize="12sp"
                    android:textStyle="bold" android:layout_marginTop="12dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <Spinner android:id="@+id/spinnerVideoSize" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="@drawable/card_bg" />

                <TextView android:text="Video Quality" android:textSize="12sp"
                    android:textStyle="bold" android:layout_marginTop="12dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <Spinner android:id="@+id/spinnerVideoQuality" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="@drawable/card_bg" />

                <TextView android:text="Watermark Method" android:textSize="12sp"
                    android:textStyle="bold" android:layout_marginTop="12dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <Spinner android:id="@+id/spinnerMethod" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="@drawable/card_bg" />

                <EditText android:id="@+id/etWatermarkText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="Custom Watermark"
                    android:inputType="text" android:padding="14dp"
                    android:background="@drawable/card_bg" android:layout_marginTop="12dp" />

                <Spinner android:id="@+id/spinnerWatermarkPosition" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="@drawable/card_bg"
                    android:layout_marginTop="8dp" />

                <Spinner android:id="@+id/spinnerWatermarkStyle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="@drawable/card_bg"
                    android:layout_marginTop="8dp" />

                <EditText android:id="@+id/etPartDuration" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="300" android:inputType="number"
                    android:hint="Part Duration (detik)" android:padding="14dp"
                    android:background="@drawable/card_bg" android:layout_marginTop="12dp" />

                <Spinner android:id="@+id/spinnerPrivacy" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="@drawable/card_bg"
                    android:layout_marginTop="8dp" />

                <Spinner android:id="@+id/spinnerAutoUpload" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="@drawable/card_bg"
                    android:layout_marginTop="8dp" />

                <Spinner android:id="@+id/spinnerUploadType" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="@drawable/card_bg"
                    android:layout_marginTop="8dp" />

                <EditText android:id="@+id/etDelay" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="60" android:inputType="number"
                    android:hint="Upload Delay" android:padding="14dp"
                    android:background="@drawable/card_bg" android:layout_marginTop="12dp" />

                <EditText android:id="@+id/etStartPart" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="1" android:inputType="number"
                    android:hint="Start Part" android:padding="14dp"
                    android:background="@drawable/card_bg" android:layout_marginTop="12dp" />

                <LinearLayout android:id="@+id/layoutTokenUpload"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone"
                    android:layout_marginTop="16dp">
                    <Button android:id="@+id/btnUploadYtToken" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="📤 Upload YouTube Token"
                        android:backgroundTint="@color/danger" android:textColor="#FFFFFF" />
                    <Button android:id="@+id/btnUploadApiKey" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="🔑 Upload API Key"
                        android:backgroundTint="@color/success" android:textColor="#FFFFFF"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <Button android:id="@+id/btnRunWorkflow" android:layout_width="match_parent"
                    android:layout_height="60dp" android:text="🚀 RUN WORKFLOW"
                    android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF"
                    android:background="@drawable/header_gradient" android:layout_marginTop="20dp" />

                <Button android:id="@+id/btnOpenFiles" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="📁 Artifacts &amp; Releases"
                    android:textColor="#FFFFFF" android:backgroundTint="@color/purple"
                    android:layout_marginTop="10dp" />

                <Button android:id="@+id/btnOpenActionsView" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="📋 Actions History"
                    android:textColor="#FFFFFF" android:backgroundTint="#673AB7"
                    android:layout_marginTop="10dp" />

                <Button android:id="@+id/btnCheckStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="📊 Check Status"
                    android:textColor="#FFFFFF" android:backgroundTint="@color/warning"
                    android:layout_marginTop="10dp" />

                <Button android:id="@+id/btnInstructions" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="📖 Instruksi"
                    android:textColor="#FFFFFF" android:backgroundTint="#00BCD4"
                    android:layout_marginTop="10dp" />

                <Button android:id="@+id/btnCredit" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="💝 Credits"
                    android:textColor="#FFFFFF" android:backgroundTint="#E91E63"
                    android:layout_marginTop="10dp" />

                <Button android:id="@+id/btnLogout" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="🔄 Reset"
                    android:textColor="#FFFFFF" android:backgroundTint="@color/text_secondary"
                    android:layout_marginTop="10dp" />

                <TextView android:id="@+id/tvStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:padding="16dp"
                    android:background="@drawable/card_bg" android:textSize="12sp"
                    android:fontFamily="monospace" android:layout_marginTop="16dp"
                    android:minHeight="80dp" android:gravity="top" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="CREATED BY KARYADI · CODING KARYADI · DESIGNED BY KARYADI"
            android:textSize="10sp" android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:gravity="center" android:padding="16dp" />
    </LinearLayout>
</ScrollView>

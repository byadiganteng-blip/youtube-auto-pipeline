<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/tvAdminInfo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="👑 ADMIN" android:textSize="20sp"
            android:textStyle="bold" android:padding="20dp" />
        <Button android:id="@+id/btnPushUpdate" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🚀 Push Update" />
        <Button android:id="@+id/btnForceUpdate" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="⚡ Force Update"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/btnAddFeature" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="➕ Add Feature"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/btnManageTokens" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🔑 Tokens"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/btnEditWorkflow" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="✏️ Workflow"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/btnViewLogs" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="📋 Logs"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/btnBroadcast" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="📢 Broadcast"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/btnViewAllDevices" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="📱 Devices"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/btnLogout" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="🚪 Logout"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>